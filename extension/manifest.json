{
  "manifest_version": 3,
  "name": "Nano翻譯官",
  "version": "0.6.0",
  "description": "透過 Chrome 本機翻譯模型閱讀英文網頁與 PDF（全頁雙語翻譯、滑鼠停留翻譯、自動翻譯），並使用 Gemini Nano 對選取的區塊產生繁中摘要。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nano翻譯官",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "runtime.js",
        "loader.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "138",
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻譯／還原此頁"
    },
    "pick-summary": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "選取區塊並摘要"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "翻譯選取文字"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
