{
  "manifest_version": 3,
  "name": "Nano翻譯官",
  "version": "0.5.0",
  "description": "透過 Chrome 本機翻譯模型閱讀英文、日文網頁（全頁雙語翻譯、滑鼠停留翻譯、自動翻譯），並使用 Gemini Nano 產生繁中摘要。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nano翻譯官",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "runtime.js",
        "loader.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
