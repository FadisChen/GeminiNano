{
  "manifest_version": 3,
  "name": "Nano翻譯官",
  "version": "0.4.0",
  "description": "透過 Chrome 本機翻譯模型閱讀英文、日文網頁，使用 Gemini Nano 產生繁中摘要。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nano翻譯官",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["auto.js"], "run_at": "document_idle" },
    { "matches": ["<all_urls>"], "js": ["runtime.js", "hover.js"], "run_at": "document_idle" }
  ],
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
